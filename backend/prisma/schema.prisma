datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. NÚCLEO DE USUÁRIOS E AUTENTICAÇÃO
// ==========================================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  avatarUrl     String?  @map("avatar_url") @db.Text
  oauthId       String   @unique @map("oauth_id") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relações reversas
  hostedRooms       Room[]             @relation("HostedRooms")
  roomParticipations RoomParticipant[]
  paidExpenses      Expense[]          @relation("PaidExpenses")
  expenseSplits     ExpenseSplit[]
  media             Media[]

  @@map("users")
}

// ==========================================
// 2. GERENCIAMENTO DE SALAS (OS ROLÊS)
// ==========================================

model Room {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(255)
  hostId    String    @map("host_id") @db.Uuid
  status    String    @default("active") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp
  closedAt  DateTime? @map("closed_at") @db.Timestamp

  // Relações
  host         User              @relation("HostedRooms", fields: [hostId], references: [id])
  participants RoomParticipant[]
  expenses     Expense[]
  media        Media[]

  @@map("rooms")
}

model RoomParticipant {
  roomId        String   @map("room_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  shareLocation Boolean  @default(false) @map("share_location")
  joinedAt      DateTime @default(now()) @map("joined_at") @db.Timestamp

  // Relações
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@map("room_participants")
}

// ==========================================
// 3. MÓDULO FINANCEIRO (COMPARTILHAMENTO DE CONTA)
// ==========================================

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  paidBy      String   @map("paid_by") @db.Uuid
  description String   @db.VarChar(255)
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relações
  room   Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  payer  User           @relation("PaidExpenses", fields: [paidBy], references: [id])
  splits ExpenseSplit[]

  @@map("expenses")
}

model ExpenseSplit {
  id         String  @id @default(uuid()) @db.Uuid
  expenseId  String  @map("expense_id") @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  percentage Decimal @db.Decimal(5, 2)
  value      Decimal @db.Decimal(10, 2)

  // Relações
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expense_splits")
}

// ==========================================
// 4. GALERIA DE MÍDIA COMPARTILHADA
// ==========================================

model Media {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  s3Key     String   @map("s3_key") @db.Text
  mediaType String   @map("media_type") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  // Relações
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("media")
}